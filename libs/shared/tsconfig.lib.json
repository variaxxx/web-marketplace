{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2021",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "types": ["node"],
    "strictBindCallApply": true,
    "strictNullChecks": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "declaration": true,
    "outDir": "../../dist/out-tsc",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "../backend/src/lib/common/service.names.ts", "../backend/src/lib/auth/rmq/revoke-refresh-token.payload.ts", "../backend/src/lib/auth/rmq/become-seller.payload.ts"]
}
