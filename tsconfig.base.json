{
  "compileOnSave": false,
  "compilerOptions": {
    "target": "es2015",
    "lib": ["es2020", "dom"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "rootDir": ".",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "@web-marketplace/api": ["libs/api/src/index.ts"],
      "@web-marketplace/backend": ["libs/backend/src/index.ts"],
      "@web-marketplace/contracts": ["libs/contracts/src/index.ts"],
      "@web-marketplace/contracts/*": ["libs/contracts/src/*"]
    },
    "declaration": false,
    "importHelpers": true,
    "sourceMap": true,
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "tmp"]
}
