generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/generated/userClient"
}

datasource db {
  provider = "postgresql"
  url      = env("USER_DATABASE_URL")
}

model User {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  phone    String?
  name     String?
  avatarId String? @map("avatar_id")

  wishlist  WishlistItem[]
  addresses Address[]
  store     Store[]

  @@map("users")
}

model Store {
  ownerId String @id

  name        String
  description String
  avatarId    String? @map("avatar_id")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model WishlistItem {
  createdAt DateTime @default(now()) @map("created_at")

  productStatus ProductStatus
  productId     String        @map("product_id")
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productId, userId])
  @@map("wishlist_items")
}

model Address {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  isDeleted Boolean  @default(false) @map("is_deleted")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  city      String
  street    String
  house     String
  latitude  Decimal
  longitude Decimal

  @@map("addresses")
}

model SellerApplication {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String                  @map("user_id")
  status SellerApplicationStatus @default(PENDING)
  note   String?

  storeName        String @map("store_name")
  storeDescription String @map("store_description")

  @@map("seller_applications")
}

enum SellerApplicationStatus {
  PENDING
  SUCCESS
  DECLINED
  CANCELLED
}

enum ProductStatus {
  REMOVED
  HIDDEN
  ON_SALE
  SOLD
}
