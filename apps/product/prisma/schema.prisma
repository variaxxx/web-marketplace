generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/generated/productClient"
}

datasource db {
  provider = "postgresql"
  url      = env("PRODUCT_DATABASE_URL")
}

model Product {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt() @map("updated_at")

  sellerId String @map("seller_id")

  name            String
  description     String
  priceCents      Int              @map("price_cents")
  status          ProductStatus
  productPictures ProductPicture[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductPicture {
  id String @id @default(uuid())

  createdAt DateTime @default(now()) @map("created_at")

  url       String
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeBytes Int     @map("size_bytes")
  mimeType  String
  isMain    Boolean @default(false) @map("is_main")
  order     Int     @default(0)

  @@map("product_pictures")
}

model Category {
  id String @id @default(uuid())

  slug String @unique
  name String

  parentCategoryId String?    @map("parent_category_id")
  parent           Category?  @relation("categories", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  children         Category[] @relation("categories")

  products Product[]

  @@map("categories")
}

enum ProductStatus {
  REMOVED
  HIDDEN
  ON_SALE
  SOLD
}
